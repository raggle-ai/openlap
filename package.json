{
  "name": "openlap",
  "version": "0.1.8",
  "description": "Request-lapping wrapper for the OpenCode CLI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raggle-ai/openlap.git"
  },
  "homepage": "https://github.com/raggle-ai/openlap#readme",
  "bugs": {
    "url": "https://github.com/raggle-ai/openlap/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./opencode": {
      "types": "./dist/opencode.d.ts",
      "import": "./dist/opencode.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "prompt-templates"
  ],
  "bin": {
    "openlap": "dist/cli.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts",
    "example:add-tests": "openlap --file ./example-prompts/add-tests.md",
    "example:analyze": "openlap --file ./example-prompts/analyze.md",
    "example:explain": "openlap --file ./example-prompts/explain.md",
    "example:fix-bugs": "openlap --file ./example-prompts/fix-bugs.md",
    "example:review": "openlap --file ./example-prompts/review.md",
    "team:review": "openlap --file ./example-prompts/review.md",
    "team:explain": "openlap --file ./example-prompts/explain.md",
    "team:fix": "openlap --file ./example-prompts/fix-bugs.md",
    "team:review:ci": "openlap --no-interactive --file ./example-prompts/review.md",
    "team:explain:ci": "openlap --no-interactive --file ./example-prompts/explain.md",
    "team:fix:ci": "openlap --no-interactive --file ./example-prompts/fix-bugs.md",
    "web": "npm run web:dev",
    "web:install": "npm --prefix ./web install",
    "web:dev": "npm --prefix ./web run dev",
    "web:build": "npm --prefix ./web run build",
    "web:preview": "npm --prefix ./web run preview",
    "web:project:create": "CLOUDFLARE_ACCOUNT_ID=${CLOUDFLARE_ACCOUNT_ID:-6a7efe766f2293634e2147aa85838c87} npx wrangler pages project create openlap --production-branch main",
    "web:deploy": "npm run web:build && CLOUDFLARE_ACCOUNT_ID=${CLOUDFLARE_ACCOUNT_ID:-6a7efe766f2293634e2147aa85838c87} npx wrangler pages deploy ./web/dist --project-name openlap --commit-dirty=true",
    "start": "node dist/cli.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "lint": "npm run typecheck && npm run typecheck:test",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@openpets/fal": "^1.0.2"
  }
}
