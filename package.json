{
  "name": "openlap",
  "version": "0.1.10",
  "description": "Request-lapping wrapper for the OpenCode CLI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raggle-ai/openlap.git"
  },
  "homepage": "https://github.com/raggle-ai/openlap#readme",
  "bugs": {
    "url": "https://github.com/raggle-ai/openlap/issues"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "prompt-templates"
  ],
  "bin": {
    "openlap": "dist/cli.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && chmod +x dist/cli.js",
    "dev": "tsx src/cli.ts",
    "example:add-tests": "openlap --file ./prompt-templates/add-tests.template.md",
    "example:analyze": "openlap --file ./prompt-templates/analyze.template.md",
    "example:explain": "openlap --file ./prompt-templates/explain.template.md",
    "example:fix-bugs": "openlap --file ./prompt-templates/fix.template.md",
    "example:review": "openlap --file ./prompt-templates/review.template.md",
    "test:input": "openlap --file @prompt-templates/explain.template.md --input",
    "team:review": "openlap --file ./prompt-templates/review.template.md",
    "team:explain": "openlap --file ./prompt-templates/explain.template.md",
    "team:fix": "openlap --file ./prompt-templates/fix.template.md",
    "team:review:ci": "openlap --no-interactive --file ./prompt-templates/review.template.md",
    "team:explain:ci": "openlap --no-interactive --file ./prompt-templates/explain.template.md",
    "team:fix:ci": "openlap --no-interactive --file ./prompt-templates/fix.template.md",
    "web:dev": "npm --prefix ./web run dev",
    "start": "node dist/cli.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "lint": "npm run typecheck && npm run typecheck:test",
    "check:precommit": "npm run lint",
    "check:prepush": "npm test && npm run build",
    "release:patch": "npm version patch && git push origin main --follow-tags",
    "release:minor": "npm version minor && git push origin main --follow-tags",
    "release:major": "npm version major && git push origin main --follow-tags",
    "prepare": "husky",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "husky": "^9.1.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@openpets/fal": "^1.0.2",
    "@opentui/core": "^0.1.79"
  }
}
